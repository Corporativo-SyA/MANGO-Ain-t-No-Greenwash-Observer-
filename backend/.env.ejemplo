# Copia este archivo como backend/.env y ajusta los valores (el .env NO se sube a git).

# Ruta al zip (o carpeta) de Global Mangrove Watch v4.1 descargado de JAXA/EORC.
# Recomendado: con GMW la máscara de manglar es la extensión oficial validada (F1 0.92-0.93).
# Windows: GMW_RUTA=C:/Users/tu_usuario/Downloads/gmw_v4112.zip
GMW_RUTA=

# Hilos de descarga de escenas Landsat (ajustar a los núcleos de la computadora)
PIPELINE_HILOS=8

# Guardrails (documento de integración)
AREA_MAX_KM2=25
# Rango mínimo de la consulta en meses. La línea base usa el histórico completo de la zona, así que
# 1 basta; súbelo solo si quieres forzar consultas más largas.
MESES_MINIMOS=1

# Caché local de escenas Landsat y clima (1 = activa). Una zona ya consultada, o una parte de ella,
# no se vuelve a descargar. Ocupa del orden de 100-300 MB por zona grande con todo su histórico;
# se puede borrar en cualquier momento (<MANGLARES_DATOS>/cache_satelital).
CACHE_SATELITAL=1

# Carpeta del historial de consultas
# MANGLARES_DATOS=C:/Users/tu_usuario/.manglares_mvp
